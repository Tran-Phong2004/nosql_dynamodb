@model List<QLDonHang.Entities.Customer>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="container-fluid mt-4">
    @* <div class="row mb-3">
        <div class="col-md-8">
            <h2><i class="bi bi-people-fill"></i> Danh sách Khách hàng</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Thêm Khách hàng
            </a>
        </div>
    </div> *@

    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Form -->
    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tìm kiếm theo Email</label>
                    <input type="text" name="email" class="form-control" placeholder="Nhập email khách hàng" value="@(ViewBag.EmailFilter ?? string.Empty)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lọc theo Quốc gia</label>
                    <select name="countryCode"
                            class="form-select"
                            asp-items="ViewBag.CountryList"
                            onchange="this.form.submit();">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary d-block w-100">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Customer Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-circle"></i> Không có khách hàng nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã KH</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Quốc gia</th>
                                <th>Điện thoại</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>
                                        <small class="text-muted">@customer.CustomerId</small>
                                    </td>
                                    <td>
                                        <strong>@customer.FullName</strong>
                                    </td>
                                    <td>@customer.Email</td>
                                    <td>
                                        <span class="badge bg-info">@customer.CountryCode</span>
                                    </td>
                                    <td>@customer.Phone</td>
                                    <td>
                                        <small>@customer.CreatedAt.ToString("dd/MM/yyyy") (UTC)</small>
                                    </td>
                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Không hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            @* <a asp-action="Details" asp-route-id="@customer.CustomerId" 
                                               class="btn btn-sm btn-info" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@customer.CustomerId" 
                                               class="btn btn-sm btn-warning" title="Sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a> *@
                                            @if (customer.IsActive)
                                            {
                                                <!-- Button block -->
                                                <a asp-action="Block" asp-route-id="@customer.CustomerId"
                                                   class="btn btn-sm btn-danger" title="Khóa tài khoản">
                                                    <i class="bi bi-lock-fill"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <!-- Button unblock -->
                                                <a asp-action="Unblock" asp-route-id="@customer.CustomerId"
                                                   class="btn btn-sm btn-secondary" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-3">
                    <p class="text-muted">Tổng số: <strong>@Model.Count</strong> khách hàng</p>
                </div>
            }
        </div>
    </div>
</div>