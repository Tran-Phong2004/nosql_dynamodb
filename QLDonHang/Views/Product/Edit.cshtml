@model QLDonHang.Entities.Products

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<style>
    .form-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        padding: 2rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .form-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .section-title {
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .btn-action {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .input-group-text {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
        border: 2px solid #e5e7eb;
        color: #667eea;
        font-weight: 600;
    }

    .image-upload-container {
        position: relative;
    }

    .image-preview {
        border: 3px dashed #e5e7eb;
        border-radius: 10px;
        padding: 3rem 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f9fafb;
    }

    .image-preview:hover {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.05);
    }

    .image-preview i {
        font-size: 3rem;
        color: #9ca3af;
        margin-bottom: 1rem;
    }

    .preview-image {
        max-width: 100%;
        max-height: 400px;
        border-radius: 10px;
        object-fit: contain;
        border: 2px solid #e5e7eb;
    }

    .image-preview.drag-over {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.1);
    }

    .current-image-label {
        background: #f3f4f6;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 1rem;
        display: inline-block;
    }

    .status-toggle {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 10px;
        margin-bottom: 2rem;
    }

    .status-switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

    .status-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #10b981;
    }

    input:checked + .slider:before {
        transform: translateX(26px);
    }

    .status-label {
        font-weight: 600;
        color: #6b7280;
    }

    .status-text {
        font-weight: 700;
    }
</style>

<div class="form-header">
    <h1 class="mb-2">
        <i class="bi bi-pencil-square"></i> Chỉnh sửa sản phẩm
    </h1>
    <p class="mb-0">Cập nhật thông tin sản phẩm: <strong>@Model.ProductName</strong></p>
</div>

<div class="form-container">
    <form asp-action="Edit" asp-controller="Product" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="ImageUrl" id="currentImageUrl" />

        <!-- Thông tin cơ bản -->
        <h4 class="section-title">
            <i class="bi bi-info-circle"></i> Thông tin cơ bản
        </h4>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="ProductName" class="form-label">Tên sản phẩm *</label>
                <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm" required />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Brand" class="form-label">Thương hiệu *</label>
                <input asp-for="Brand" class="form-control" placeholder="Nhập thương hiệu" required />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Category" class="form-label">Danh mục *</label>
                <select asp-for="Category" class="form-select" required>
                    <option value="">-- Chọn danh mục --</option>
                    <option value="Điện tử">Điện tử</option>
                    <option value="Thời trang">Thời trang</option>
                    <option value="Gia dụng">Gia dụng</option>
                    <option value="Thực phẩm">Thực phẩm</option>
                    <option value="Sách">Sách</option>
                    <option value="Mỹ phẩm">Mỹ phẩm</option>
                    <option value="Đồ chơi">Đồ chơi</option>
                    <option value="Thể thao">Thể thao</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SKU" class="form-label">Mã SKU *</label>
                <input asp-for="SKU" class="form-control" placeholder="VD: SKU-001" required />
                <span asp-validation-for="SKU" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="4" 
                          placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Hình ảnh sản phẩm</label>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="current-image-label">
                        <i class="bi bi-image"></i> Ảnh hiện tại: 
                        <a href="@Model.ImageUrl" target="_blank">Xem ảnh</a>
                    </div>
                }
                
                <div class="image-upload-container">
                    <div class="image-preview" id="imagePreview" style="@(!string.IsNullOrEmpty(Model.ImageUrl) ? "display: none;" : "")">
                        <i class="bi bi-cloud-upload"></i>
                        <p class="mb-0">Kéo thả ảnh vào đây hoặc click để chọn</p>
                        <small class="text-muted">JPG, PNG, GIF, WEBP (Tối đa 5MB)</small>
                    </div>
                    <input type="file" name="imageFile" id="imageFile" class="d-none" 
                           accept=".jpg,.jpeg,.png,.gif,.webp" />
                    
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" id="imagePreviewImg" class="preview-image" />
                    }
                    else
                    {
                        <img id="imagePreviewImg" class="preview-image" style="display: none;" />
                    }
                    
                    <div class="mt-2">
                        <button type="button" id="changeImageBtn" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-repeat"></i> Đổi ảnh
                        </button>
                        <button type="button" id="removeImageBtn" class="btn btn-outline-danger btn-sm" 
                                style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "display: none;" : "")">
                            <i class="bi bi-trash"></i> Xóa ảnh
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin thêm -->
        <h4 class="section-title">
            <i class="bi bi-box-seam"></i> Thông tin thêm
        </h4>

        <div class="row g-3 mb-4">
            @* <div class="col-md-4">
                <label asp-for="StockQuantity" class="form-label">Số lượng tồn kho *</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                    <input asp-for="StockQuantity" type="number" class="form-control" 
                           min="0" placeholder="0" required />
                </div>
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div> *@

            <div class="col-md-4">
                <label asp-for="Weight" class="form-label">Cân nặng (kg)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                    <input asp-for="Weight" type="number" step="0.01" class="form-control" 
                           min="0" placeholder="0.00" />
                </div>
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Dimensions" class="form-label">Kích thước (cm)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-rulers"></i></span>
                    <input asp-for="Dimensions" class="form-control" placeholder="20x15x10" />
                </div>
                <span asp-validation-for="Dimensions" class="text-danger"></span>
            </div>
        </div>

        <!-- Tags -->
        <h4 class="section-title">
            <i class="bi bi-tags"></i> Tags (Tùy chọn)
        </h4>

        <div class="mb-4">
            <input type="text" id="tagsInput" class="form-control" 
                   placeholder="Nhập tags và nhấn Enter (VD: mới, giảm giá, hot...)" />
            <div id="tagsDisplay" class="mt-2"></div>
            <input type="hidden" id="tagsHidden" name="Tags" value="@string.Join(",", Model.Tags ?? Array.Empty<string>())" />
            <small class="text-muted">
                <i class="bi bi-info-circle"></i> Nhập tag và nhấn Enter để thêm
            </small>
        </div>

        <!-- Trạng thái sản phẩm -->
        <h4 class="section-title">
            <i class="bi bi-toggle-on"></i> Trạng thái
        </h4>

        <div class="status-toggle">
            <label class="status-switch">
                <input type="checkbox" asp-for="IsActive" id="isActiveCheckbox">
                <span class="slider"></span>
            </label>
            <div>
                <div class="status-label">Trạng thái sản phẩm</div>
                <div class="status-text" id="statusText">
                    @if (Model.IsActive)
                    {
                        <i class="bi bi-check-circle-fill"></i> <span>Đang bán</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill"></i> <span>Ngừng bán</span>
                    }
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary btn-action">
                <i class="bi bi-x-circle"></i> Hủy
            </a>
            <button type="submit" class="btn btn-warning btn-action">
                <i class="bi bi-check-circle"></i> Cập nhật
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Status Toggle
        const isActiveCheckbox = document.getElementById('isActiveCheckbox');
        const statusText = document.getElementById('statusText');

        isActiveCheckbox.addEventListener('change', function() {
            if (this.checked) {
                statusText.innerHTML = '<i class="bi bi-check-circle-fill"></i> Bán';
                statusText.style.color = '#10b981';
            } else {
                statusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Ngừng bán';
                statusText.style.color = '#ef4444';
            }
        });

        // Set initial color
        if (isActiveCheckbox.checked) {
            statusText.style.color = '#10b981';
        } else {
            statusText.style.color = '#ef4444';
        }

        // Image Upload Handling
        const imagePreview = document.getElementById('imagePreview');
        const imageFile = document.getElementById('imageFile');
        const imagePreviewImg = document.getElementById('imagePreviewImg');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const changeImageBtn = document.getElementById('changeImageBtn');
        const currentImageUrl = document.getElementById('currentImageUrl');

        // Click to change image
        changeImageBtn.addEventListener('click', () => {
            imageFile.click();
        });

        // Click preview to change
        imagePreview.addEventListener('click', () => {
            imageFile.click();
        });

        // File input change
        imageFile.addEventListener('change', function(e) {
            handleFileSelect(e.target.files);
        });

        // Drag and drop
        ['dragover', 'dragenter'].forEach(eventName => {
            imagePreview.addEventListener(eventName, (e) => {
                e.preventDefault();
                imagePreview.classList.add('drag-over');
            });
        });

        ['dragleave', 'dragend'].forEach(eventName => {
            imagePreview.addEventListener(eventName, () => {
                imagePreview.classList.remove('drag-over');
            });
        });

        imagePreview.addEventListener('drop', (e) => {
            e.preventDefault();
            imagePreview.classList.remove('drag-over');
            handleFileSelect(e.dataTransfer.files);
        });

        // Remove image
        removeImageBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (confirm('Bạn có chắc muốn xóa ảnh này?')) {
                imageFile.value = '';
                imagePreviewImg.style.display = 'none';
                imagePreview.style.display = 'block';
                removeImageBtn.style.display = 'none';
                changeImageBtn.style.display = 'none';
                currentImageUrl.value = '';
            }
        });

        function handleFileSelect(files) {
            if (files.length === 0) return;

            const file = files[0];
            
            // Validate file type
            const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
            if (!validTypes.includes(file.type)) {
                alert('Chỉ cho phép upload ảnh định dạng JPG, PNG, GIF, WEBP.');
                return;
            }

            // Validate file size (5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('Kích thước ảnh không được vượt quá 5MB.');
                return;
            }

            // Preview image
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreviewImg.src = e.target.result;
                imagePreviewImg.style.display = 'block';
                imagePreview.style.display = 'none';
                removeImageBtn.style.display = 'inline-block';
                changeImageBtn.style.display = 'inline-block';
            };
            reader.readAsDataURL(file);
        }

        // Tags Management
        let tags = '@string.Join(",", Model.Tags ?? Array.Empty<string>())'.split(',').filter(t => t);
        
        // Display existing tags
        if (tags.length > 0) {
            updateTagsDisplay();
        }
        
        document.getElementById('tagsInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const tag = this.value.trim();
                if (tag && !tags.includes(tag)) {
                    tags.push(tag);
                    updateTagsDisplay();
                    this.value = '';
                }
            }
        });
        
        function updateTagsDisplay() {
            const display = document.getElementById('tagsDisplay');
            display.innerHTML = tags.map((tag, index) => `
                <span class="badge bg-primary me-2 mb-2" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                    ${tag}
                    <i class="bi bi-x" style="cursor: pointer;" onclick="removeTag(${index})"></i>
                </span>
            `).join('');
            
            document.getElementById('tagsHidden').value = tags.join(',');
        }
        
        function removeTag(index) {
            tags.splice(index, 1);
            updateTagsDisplay();
        }
    </script>
}