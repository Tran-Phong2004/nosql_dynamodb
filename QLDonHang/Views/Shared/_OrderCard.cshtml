            }
        }

        function reorder(orderId) {
            if (confirm('Bạn muốn đặt lại đơn hàng này?')) {
                // TODO: Implement reorder functionality
                console.log('Reordering:', orderId);
                // You can add logic to add items back to cart
            }
        }
    </script>
}