@model List<QLDonHang.Entities.StockReceipt>

@{
    ViewData["Title"] = "Quản lý nhập kho";
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentWarehouse = ViewBag.CurrentWarehouse as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<style>
    .page-header {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
    }

    .stats-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

    .stats-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .filter-section {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .receipts-table {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
            border: none;
            font-weight: 600;
            color: #374151;
            padding: 1rem;
        }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
        }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-approved {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-completed {
        background: #d1fae5;
        color: #065f46;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        transition: all 0.3s ease;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
</style>

<!-- Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="mb-2">
                <i class="bi bi-box-seam"></i> Quản lý nhập kho
            </h1>
            <p class="mb-0 opacity-75">Theo dõi và quản lý các phiếu nhập hàng vào kho</p>
        </div>
        <a asp-action="Create" class="btn btn-light btn-lg">
            <i class="bi bi-plus-circle"></i> Tạo phiếu nhập
        </a>
    </div>
</div>

<!-- Statistics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stats-icon" style="background: #fef3c7; color: #92400e;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="text-muted small">Chờ duyệt</div>
                    <div class="h4 mb-0">@Model.Count(r => r.Status == "Pending")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stats-icon" style="background: #dbeafe; color: #1e40af;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Đã duyệt</div>
                    <div class="h4 mb-0">@Model.Count(r => r.Status == "Approved")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stats-icon" style="background: #d1fae5; color: #065f46;">
                    <i class="bi bi-check-all"></i>
                </div>
                <div>
                    <div class="text-muted small">Hoàn thành</div>
                    <div class="h4 mb-0">@Model.Count(r => r.Status == "Completed")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stats-icon" style="background: #fee2e2; color: #991b1b;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Đã hủy</div>
                    <div class="h4 mb-0">@Model.Count(r => r.Status == "Cancelled")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filter-section">
    <form method="get" asp-action="Index">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Chờ duyệt</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Đã duyệt</option>
                    <option value="Completed" selected="@(currentStatus == "Completed")">Hoàn thành</option>
                    <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Kho</label>
                <input type="text" name="warehouse" class="form-control" placeholder="Mã kho" value="@currentWarehouse" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="fromDate" class="form-control" value="@fromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="toDate" class="form-control" value="@toDate" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Table -->
<div class="receipts-table">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Kho</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày nhập</th>
                        <th>Người tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in Model)
                    {
                        <tr>
                            <td>
                                <strong>@receipt.ReceiptId</strong>
                            </td>
                            <td>
                                <i class="bi bi-building"></i> @receipt.WarehouseId
                            </td>
                            <td>
                                <div>@receipt.SupplierName</div>
                                <small class="text-muted">@receipt.SupplierId</small>
                            </td>
                            <td>
                                <i class="bi bi-calendar3"></i>
                                @receipt.ReceiptDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <i class="bi bi-person"></i> @receipt.CreatedBy
                            </td>
                            <td>
                                @switch (receipt.Status)
                                {
                                    case "Pending":
                                        <span class="status-badge status-pending">
                                            <i class="bi bi-clock-history"></i> Chờ duyệt
                                        </span>
                                        break;
                                    case "Approved":
                                        <span class="status-badge status-approved">
                                            <i class="bi bi-check-circle"></i> Đã duyệt
                                        </span>
                                        break;
                                    case "Completed":
                                        <span class="status-badge status-completed">
                                            <i class="bi bi-check-all"></i> Hoàn thành
                                        </span>
                                        break;
                                    case "Cancelled":
                                        <span class="status-badge status-cancelled">
                                            <i class="bi bi-x-circle"></i> Đã hủy
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@receipt.ReceiptId"
                                   class="btn btn-sm btn-outline-primary btn-action">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            Tổng số: <strong>@Model.Count</strong> phiếu nhập
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h5>Chưa có phiếu nhập kho nào</h5>
            <p class="text-muted">Bắt đầu bằng cách tạo phiếu nhập kho mới</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tạo phiếu nhập
            </a>
        </div>
    }
</div>